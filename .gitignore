# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/

# Project media and generated files: large, and regenerable.
# Keep project.json (the script and edit) under version control.
projects/*/media/
projects/*/build/

# Secrets never go in the repo (keys are injected by the environment proxy).
.env
.env.*
*.key
*.pem
