{
  "title": "إعلان تطبيق الحرفة",
  "voice": "Leda",
  "sections": [
    {
      "id": 1,
      "lines": [
        {
          "say": "تدري؟ كل قطعة مسوّاية بالإيد بيها روح… وبيها قصة."
        }
      ]
    },
    {
      "id": 2,
      "lines": [
        {
          "say": "إنت حرفي؟ تسوي أعمال يدوية؟"
        },
        {
          "say": "تنقش على النحاس والحجر؟ تصوغ ذهب وفضة، أو تشتغل على الأحجار الكريمة؟"
        },
        {
          "say": "تخيط، تطرّز، تسوي فخار وخوص…"
        },
        {
          "say": "تعبك يستاهل ينشاف!"
        }
      ]
    },
    {
      "id": 3,
      "lines": [
        {
          "say": "نزّل تطبيق «الحرفة» وانشر منتجاتك وإبداعك كله بمكان واحد."
        },
        {
          "say": "لوحة تحكم سهلة وسلسة، تضيف منتجك بدقيقة وتتابع طلباتك من تلفونك."
        },
        {
          "say": "التحميل مجاني، والنشر مجاني، وأول ثلاث أشهر بلا ولا فلس عمولة!"
        },
        {
          "say": "زباين أكثر… مبيعات أكثر… وإنت گاعد بمكانك."
        }
      ]
    },
    {
      "id": 4,
      "lines": [
        {
          "say": "وإنت اللي تدوّر على هدية حلوة؟ لا تتعب نفسك وتلف بالسوگ من محل لمحل."
        },
        {
          "say": "بالحِرْفة تلگه رواد الحرف والصناعات اليدوية العراقية كلهم بمكان واحد.",
          "show": "بـ«الحرفة» تلگه رواد الحرف والصناعات اليدوية العراقية كلهم بمكان واحد."
        },
        {
          "say": "تلگه قطعة مميزة ما تتكرر، ولها قصتها."
        },
        {
          "say": "والتوصيل بسعر ثابت، والدفع من توصلك الطلبية."
        }
      ]
    },
    {
      "id": 5,
      "lines": [
        {
          "say": "«الحرفة»… من إيد الحرفي العراقي لبيتك."
        },
        {
          "say": "نزّله هسه من گوگل بلي، وادعم ابن بلدك.",
          "show": "نزّله هسه من Google Play، وادعم ابن بلدك."
        }
      ]
    }
  ],
